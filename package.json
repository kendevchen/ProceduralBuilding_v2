{
  "name": "procedural-building-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check:rooms": "node scripts/check-room-editor.mjs",
    "check:plans": "node scripts/check-plans.mjs",
    "check:variety": "node scripts/check-variety.mjs",
    "check:templates": "node scripts/check-templates.mjs",
    "check:courtyard": "node scripts/check-courtyard.mjs",
    "check:deep": "node scripts/check-deep.mjs",
    "check:cores": "node scripts/check-cores.mjs",
    "check:topology": "node scripts/check-topology.mjs",
    "bench:plans": "node scripts/check-plans.mjs --benchmark",
    "bench:interior": "node --expose-gc scripts/bench-interior.mjs",
    "check:unfold": "node scripts/check-unfold.mjs",
    "check:buildings": "node scripts/check-buildings.mjs",
    "check:facade": "node scripts/check-facade-transparency.mjs",
    "check:performance": "node scripts/check-performance.mjs",
    "preview": "vite preview",
    "kit": "sh blender/make_kit.sh",
    "tex": "sh blender/make_kit.sh tex",
    "rooms": "sh blender/make_kit.sh rooms",
    "ao": "sh blender/make_kit.sh ao"
  },
  "dependencies": {
    "lil-gui": "^0.20.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3"
  }
}
